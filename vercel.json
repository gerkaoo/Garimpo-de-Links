{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": { "api/*.js": { "maxDuration": 30 } },
  "crons": [
    { "path": "/api/cron-08", "schedule": "0 11 * * *" },
    { "path": "/api/cron-12", "schedule": "0 15 * * *" },
    { "path": "/api/cron-16", "schedule": "0 19 * * *" },
    { "path": "/api/cron-20", "schedule": "0 23 * * *" }
  ],
  "headers": [
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" }
    ] },
    { "source": "/api/(.*)", "headers": [ { "key": "Cache-Control", "value": "private, no-store" } ] }
  ]
}
